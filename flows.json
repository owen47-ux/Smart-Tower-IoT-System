    {
        "id": "fa85d4ec6a754895",
        "type": "function",
        "z": "6399adbdd5265a4a",
        "name": "Format Multipart",
        "func": "// เตรียมข้อมูล Multipart Form Data ส่งให้ Flask AI\nvar boundary = '--------------------------' + Math.floor(Math.random() * 1000000000);\nvar filename = \"capture.jpg\";\n\nvar header = '--' + boundary + '\\r\\n' +\n             'Content-Disposition: form-data; name=\"image\"; filename=\"' + filename + '\"\\r\\n' +\n             'Content-Type: image/jpeg\\r\\n\\r\\n';\n\nvar footer = '\\r\\n--' + boundary + '--\\r\\n';\n\nvar headerBuffer = Buffer.from(header, 'utf8');\nvar footerBuffer = Buffer.from(footer, 'utf8');\n\n// บรรจุไฟล์ภาพ Buffer ลงใน Body\nmsg.payload = Buffer.concat([headerBuffer, msg.payload, footerBuffer]);\n\nmsg.headers = {\n    'Content-Type': 'multipart/form-data; boundary=' + boundary\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
