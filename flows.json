    {
        "id": "ba24b9004f9eeed5",
        "type": "function",
        "z": "6399adbdd5265a4a",
        "name": "Prep n8n Webhook",
        "func": "var isKnown = msg.payload.is_known;\nvar name = msg.payload.name || 'Unknown';\nvar timestamp = new Date().toLocaleString(\"th-TH\");\n\n// ดึงรูป Base64 จาก memory\nvar base64Img = flow.get('latest_image') || ''; \n\nvar captionText = \"\";\nvar alertType = \"\";\n\nif (isKnown) {\n    alertType = \"MEMBER\";\n    captionText = \"🟢 <b>WELCOME HOME | รายงานการเข้าบ้าน</b>\\n\\n\" +\n                  \"👤 <b>ชื่อสมาชิก:</b> \" + name + \"\\n\" +\n                  \"🔑 <b>สถานะ:</b> สมาชิกในบ้าน (Authorized)\\n\" +\n                  \"⏰ <b>เวลา:</b> \" + timestamp + \"\\n\" +\n                  \"📍 <b>ตำแหน่ง:</b> กล้องประตูหน้าบ้าน\\n\" +\n                  \"🛡 <b>สถานะระบบ:</b> ปลอดภัย\\n\\n\" +\n                  \"<i>ยินดีต้อนรับกลับบ้านครับ!</i>\";\n} else {\n    alertType = \"INTRUDER\";\n    var incId = \"INC-\" + Date.now().toString().slice(-6);\n    captionText = \"🚨 <b>INTRUDER ALERT | รายงานเตือนภัย</b>\\n\\n\" +\n                  \"⚠️ <b>คำเตือน: ตรวจพบบุคคลไม่ระบุตัวตน!</b>\\n\" +\n                  \"👤 <b>ผล AI:</b> Unknown / Unregistered\\n\" +\n                  \"⏰ <b>เวลา:</b> \" + timestamp + \"\\n\" +\n                  \"📍 <b>ตำแหน่ง:</b> กล้องประตูหน้าบ้าน\\n\" +\n                  \"🆔 <b>Incident ID:</b> #\" + incId + \"\\n\\n\" +\n                  \"📢 <i>ระบบบันทึกประวัติลง Database แล้ว โปรดตรวจสอบ</i>\";\n}\n\n// แพ็กข้อมูล JSON ส่งไปหา n8n\nmsg.payload = {\n    alert_type: alertType,\n    person_name: name,\n    is_known: isKnown,\n    timestamp: timestamp,\n    caption: captionText,\n    image_base64: base64Img\n};\n\nmsg.headers = {\n    'Content-Type': 'application/json'\n};\n\nreturn msg;",
