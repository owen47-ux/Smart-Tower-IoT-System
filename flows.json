    {
        "id": "67d12d6275c1c45d",
        "type": "function",
        "z": "6399adbdd5265a4a",
        "name": "Format Table UI",
        "func": "var rows = msg.payload || [];\nvar tableData = [];\n\nfor (var i = 0; i < rows.length; i++) {\n    var r = rows[i];\n    var dateStr = new Date(r.scanned_at).toLocaleString(\"th-TH\");\n    tableData.push({\n        id: r.id,\n        name: r.person_name,\n        status: r.status === 'safe' ? '✅ ปลอดภัย' : '🚨 อันตราย',\n        time: dateStr\n    });\n}\n\nmsg.payload = tableData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
