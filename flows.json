    {
        "id": "34a3f627be63c10c",
        "type": "function",
        "z": "6399adbdd5265a4a",
        "name": "Prep UI Data",
        "func": "// ถ้าข้อมูลมาจาก take photo (รูปภาพ Buffer) ให้เซฟเก็บไว้ใน flow\nif (Buffer.isBuffer(msg.payload)) {\n    var base64Img = \"data:image/jpeg;base64,\" + msg.payload.toString('base64');\n    flow.set('latest_image', base64Img);\n    return null; // รอผล AI Scan\n}\n\n// ถ้าข้อมูลมาจาก AI Scan (JSON) ให้ดึงรูปสดมารวมแล้วส่งออก UI\nif (typeof msg.payload === 'object') {\n    var imgData = flow.get('latest_image') || '';\n    \n    msg.payload = {\n        image: imgData,\n        status: msg.payload.status || 'danger',\n        name: msg.payload.name || 'Unknown',\n        is_known: msg.payload.is_known || false,\n        timestamp: new Date().toLocaleString(\"th-TH\"),\n        _random: Math.random() // บังคับ UI เรนเดอร์รูปใหม่ตลอดเวลา\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1390,
