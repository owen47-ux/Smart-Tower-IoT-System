    {
        "id": "9f4ba2606ee3fd6d",
        "type": "ui_template",
        "z": "6399adbdd5265a4a",
        "group": "9046e66731db2a90",
        "name": "Dashboard UI",
        "order": 1,
        "width": "6",
        "height": "8",
        "format": "<div style=\"text-align: center; padding: 12px; background: #fafafa; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);\">\n    <!-- สถานะผลการตรวจจับ -->\n    <div ng-style=\"{\n        'background-color': (msg.payload.status == 'safe' || msg.payload.is_known) ? '#e8f5e9' : '#ffebee',\n        'border': '2px solid ' + ((msg.payload.status == 'safe' || msg.payload.is_known) ? '#4caf50' : '#f44336')\n    }\" style=\"border-radius: 8px; padding: 12px; margin-bottom: 12px;\">\n        \n        <h3 ng-style=\"{\n            'color': (msg.payload.status == 'safe' || msg.payload.is_known) ? '#2e7d32' : '#c62828'\n        }\" style=\"margin: 0; font-weight: bold;\">\n            {{ (msg.payload.status == 'safe' || msg.payload.is_known) ? 'สถานะ: ปลอดภัย' : 'สถานะ: อันตราย (พบผู้บุกรุก)' }}\n        </h3>\n        \n        <p style=\"margin: 6px 0 0 0; font-size: 16px; font-weight: 500; color: #333;\">\n            {{ (msg.payload.status == 'safe' || msg.payload.is_known) ? 'ยินดีต้อนรับ: ' + msg.payload.name : 'บุคคลระบุตัวตนไม่ได้ (' + msg.payload.name + ')' }}\n        </p>\n        <small style=\"color: #666;\">เวลาตรวจจับ: {{msg.payload.timestamp}}</small>\n    </div>\n\n    <!-- แสดงรูปถ่ายสด ณ วินาทีนั้น -->\n    <div ng-if=\"msg.payload.image\">\n        <img ng-src=\"{{msg.payload.image}}\" style=\"width: 100%; max-width: 360px; border-radius: 8px; border: 1px solid #ddd;\">\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1600,
        "y": 220,
