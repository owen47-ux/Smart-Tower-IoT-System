    {
        "id": "7054cbd5a2a8d53d",
        "type": "function",
        "z": "6399adbdd5265a4a",
        "name": "Prep MySQL Insert",
        "func": "// ดึงข้อมูลผลลัพธ์จาก AI Scan\nvar name = msg.payload.name || 'Unknown';\nvar status = msg.payload.status || 'danger';\nvar imagePath = '/home/owen/camera_captures/latest.jpg';\n\n// สร้างคำสั่ง SQL บันทึกลง scan_logs\nvar sql = \"INSERT INTO scan_logs (person_name, status, image_path, scanned_at) VALUES ('\" + name + \"', '\" + status + \"', '\" + imagePath + \"', NOW())\";\n\n// ใส่ทั้ง topic และ payload ป้องกันโหนด MySQL สับสน\nmsg.topic = sql;\nmsg.payload = sql;\n\nreturn msg;",
        "outputs": 1,
