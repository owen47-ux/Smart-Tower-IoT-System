    {
        "id": "92f28cd22a9be701",
        "type": "ui_template",
        "z": "9587ecd82695815b",
        "group": "11a8b64ffabf5db4",
        "name": "ui_template",
        "order": 2,
        "width": "6",
        "height": "8",
        "format": "<div style=\"padding: 10px; background: #ffffff; border-radius: 8px;\">\n    <h3 style=\"margin-top: 0; color: #333; text-align: center;\">📋 ประวัติการตรวจจับล่าสุด</h3>\n    <table style=\"width: 100%; border-collapse: collapse; font-family: sans-serif; text-align: left;\">\n        <thead>\n            <tr style=\"background-color: #f2f2f2; border-bottom: 2px solid #ddd;\">\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">ID</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd;\">ชื่อบุคคล</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd;\">สถานะ</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd;\">เวลาตรวจจับ</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat=\"row in msg.payload\" style=\"border-bottom: 1px solid #ddd;\">\n                <td style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">{{row.id}}</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">{{row.name}}</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{row.status}}</td>\n                <td style=\"padding: 8px; border: 1px solid #ddd; color: #666;\">{{row.time}}</td>\n            </tr>\n        </tbody>\n    </table>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
