        "name": "แปลงชื่อโซนภาษาไทย",
        "func": "let zone = \"\";\n\nswitch(msg.topic) {\n    case \"security/corner1\":\n        zone = \"กำแพงโซน 1\";\n        break;\n    case \"security/corner2\":\n        zone = \"กำแพงโซน 2\";\n        break;\n    case \"security/corner3\":\n        zone = \"กำแพงโซน 3\";\n        break;\n    case \"security/corner4\":\n        zone = \"กำแพงโซน 4\";\n        break;\n    default:\n        zone = msg.topic;\n}\n\nmsg.payload = \"🚨 WARNING: ตรวจพบสิ่งแปลกปลอมบริเวณ \" + zone + \"!\";\nreturn msg;",
